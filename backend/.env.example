# Copia este archivo como ".env" y rellena los valores reales.
# El .env real nunca debe subirse al repositorio (ver .gitignore).

# Conexion a PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/nemblex
DB_USER=
DB_PASSWORD=

# Perfil activo de Spring (dev | test)
SPRING_PROFILES_ACTIVE=dev

# API Key de Gemini (usada por el agente de IA: clasificacion, RAG, etc.)
GEMINI_API_KEY=
